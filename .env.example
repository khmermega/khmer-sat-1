# KHMER-SAT 1 ground station configuration.
# Copy with generated secrets:  python scripts/init_env.py
# Empty secret values below are filled with random values by that script.
# NEVER commit .env.

# ---- mode ----
GS_MODE=SIMULATION                # SIMULATION | HARDWARE

# ---- security (required) ----
# 64 hex chars (256-bit) shared with the onboard computer
COMMAND_HMAC_KEY=
# bearer token: routine commands, sim controls
OPERATOR_TOKEN=
# bearer token: safety-critical commands (ARM/EXECUTE)
ADMIN_TOKEN=
INTERLOCK_ARM_TIMEOUT_S=30
COMMAND_ACK_TIMEOUT_S=60

# ---- database (local dev default is SQLite; Docker uses PostgreSQL/TimescaleDB) ----
DATABASE_URL=sqlite:///./data/ground.db
POSTGRES_USER=khmersat
POSTGRES_DB=khmersat
POSTGRES_PASSWORD=

# ---- image object storage ----
OBJECT_STORE=local                # local | s3
LOCAL_OBJECT_DIR=./data/objects
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=khmersat-images
MINIO_ROOT_USER=khmersat
MINIO_ROOT_PASSWORD=

# ---- MQTT telemetry bridge (authenticated broker, Docker only by default) ----
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=khmersat
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=khmersat1

# ---- simulation ----
SIM_TIME_SCALE=1                  # 0.1 .. 200
SIM_PASS_OFFSET_MIN=10            # synthetic orbit: overhead pass N minutes after start
SIM_LINK_MODE=bench               # bench (always connected) | orbital (visibility-gated)
SIM_SEED=7
ONBOARD_DATA_DIR=./data/onboard-sim
ONBOARD_STORAGE_MB=64

# ---- simulated ground station (configurable; real site TBD) ----
GS_NAME=Phnom Penh (simulated)
GS_LAT=11.5564
GS_LON=104.9282
GS_ALT_M=12
GS_MIN_EL=10

# ---- service ----
TICK_HZ=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=true
