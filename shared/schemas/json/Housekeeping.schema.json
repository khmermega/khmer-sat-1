      "required": [
        "used_bytes",
        "capacity_bytes",
        "images_stored",
        "downlink_queue"
      ],
      "title": "StorageState",
      "type": "object"
    },
    "ThermalState": {
      "additionalProperties": false,
      "properties": {
        "cpu_c": {
          "title": "Cpu C",
          "type": "number"
        },
        "payload_c": {
          "title": "Payload C",
          "type": "number"
        },
        "battery_c": {
          "title": "Battery C",
          "type": "number"
        },
        "panel_c": {
          "title": "Panel C",
          "type": "number"
        }
      },
      "required": [
        "cpu_c",
        "payload_c",
        "battery_c",
        "panel_c"
      ],
      "title": "ThermalState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Periodic HOUSEKEEPING payload.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "utc": {
      "format": "date-time",
      "title": "Utc",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "uptime_s": {
      "title": "Uptime S",
      "type": "number"
    },
    "boot_count": {
      "title": "Boot Count",
      "type": "integer"
    },
    "cpu_load_pct": {
      "title": "Cpu Load Pct",
      "type": "number"
    },
    "orbit": {
      "$ref": "#/$defs/OrbitState"
    },
    "power": {
      "$ref": "#/$defs/PowerState"
    },
    "thermal": {
      "$ref": "#/$defs/ThermalState"
    },
    "attitude": {
      "$ref": "#/$defs/AttitudeState"
    },
    "gnss": {
      "$ref": "#/$defs/GnssState"
    },
    "storage": {
      "$ref": "#/$defs/StorageState"
    },
    "faults": {
      "items": {
        "type": "string"
      },
      "title": "Faults",
      "type": "array"
    },
    "last_cmd_seq": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Cmd Seq"
    },
    "simulated": {
      "default": true,
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "utc",
    "mode",
    "uptime_s",
    "boot_count",
    "cpu_load_pct",
    "orbit",
    "power",
    "thermal",
    "attitude",
    "gnss",
    "storage"
  ],
  "title": "Housekeeping",
  "type": "object",
  "$id": "https://khmer-sat-1.invalid/schemas/1.0.0/Housekeeping.json"
}
